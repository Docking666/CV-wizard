{
  "pdf": {
    "format": "A4",
    "margin": {
      "top": "20mm",
      "right": "15mm",
      "bottom": "20mm",
      "left": "15mm"
    },
    "displayHeaderFooter": true,
    "headerTemplate": "<div></div>",
    "footerTemplate": "<div style='font-size:9px;text-align:center;width:100%;color:#666;'>Page <span class='pageNumber'></span> / <span class='totalPages'></span></div>",
    "printBackground": true
  },
  "png": {
    "fullPage": true,
    "omitBackground": false,
    "clip": {
      "x": 0,
      "y": 0,
      "width": 794,
      "height": 1123
    },
    "deviceScaleFactor": 2
  }
}
